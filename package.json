{
  "name": "keep",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787",
    "deploy": "wrangler deploy",
    "check": "tsc && cargo fmt --manifest-path cli/Cargo.toml --check && cargo clippy --manifest-path cli/Cargo.toml --locked -- -D warnings",
    "test": "node --test test/e2e.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}
